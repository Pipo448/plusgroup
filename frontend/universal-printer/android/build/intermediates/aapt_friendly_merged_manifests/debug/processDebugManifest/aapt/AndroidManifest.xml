<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.plusgroupe.printer" >

    <uses-sdk android:minSdkVersion="24" />

    <!-- ✅ NOUVO — Pou telechaje logo/imaj pou enprime -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Pou Bluetooth ESC/POS enprimant -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- Android 12+ (API 31+) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Pou skanere aparèy Bluetooth sou vye vèsyon Android -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Sunmi enprimant service (pou detekte automate) -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
        <package android:name="woyou.aidlservice.jiuv5" />
        <!-- iMin -->
        <package android:name="com.imin.printerservice" />
        <!-- Telpo -->
        <package android:name="com.telpo.tps550.api" />
    </queries>

</manifest>