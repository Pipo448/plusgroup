// backend/prisma/schema/restaurant-tables.prisma

// ✅ NOUVO — Tab restoran (Tab 1, Tab 2, Teras A...). Estati a swiv si tab
// la lib, okipe (gen yon kòmand louvri), oswa rezève.
model RestaurantTable {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId  String   @map("tenant_id")
  branchId  String?  @map("branch_id")
  name      String   @db.VarChar(50)
  zone      String?  @db.VarChar(50)
  seats     Int      @default(4)
  status    String   @default("lib") @db.VarChar(15)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_table_tenant_fk")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "restaurant_table_branch_fk")
  orders    RestaurantOrder[]

  @@index([tenantId, status], map: "idx_restaurant_table_tenant_status")
}

// ✅ NOUVO — Kòmand ki "louvri" sou yon tab: rete aktif pandan tout repa a,
// grandi lè yo ajoute pla, epi FÈMEN lè yo konvèti l an Fakti (paj Fakti
// deja egziste a fè kalkil/peman/enprime — nou pa dwaplike anyen).
model RestaurantOrder {
  id                 String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId           String    @map("tenant_id")
  tableId            String    @map("table_id")
  status             String    @default("louvri") @db.VarChar(15)
  convertedInvoiceId String?   @map("converted_invoice_id")
  notes              String?
  openedAt           DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_order_tenant_fk")
  table              RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_order_table_fk")
  creator            User?     @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "restaurant_order_creator_fk")
  items              RestaurantOrderItem[]

  @@index([tenantId, status], map: "idx_restaurant_order_tenant_status")
  @@index([tableId], map: "idx_restaurant_order_table")
}

// ✅ NOUVO — Yon liy pla nan yon kòmand. `kitchenStatus` swiv si liy lan
// deja voye nan kizin (pou tikè kizin), san l pa afekte fakti final la.
model RestaurantOrderItem {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId       String   @map("order_id")
  productId     String?  @map("product_id")
  description   String   @db.VarChar(150)
  quantity      Decimal  @db.Decimal(10, 2)
  unitPriceHtg  Decimal  @map("unit_price_htg") @db.Decimal(12, 2)
  notes         String?
  kitchenStatus String   @default("an_atant") @map("kitchen_status") @db.VarChar(15)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order         RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_order_item_order_fk")
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "restaurant_order_item_product_fk")

  @@index([orderId], map: "idx_restaurant_order_item_order")
}
