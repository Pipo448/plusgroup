model KlinikPatient {
  id                  String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId            String                  @map("tenant_id")
  numeroDossier       String                  @unique @map("numero_dossier")
  nom                 String
  prenom              String
  dateNaissance       DateTime?               @map("date_naissance") @db.Timestamptz(6)
  sexe                Sexe?                   @default(AUTRE)
  adresse             String?
  telephone           String?
  email               String?
  groupeSanguin       GroupeSanguin           @default(INCONNU) @map("groupe_sanguin")
  allergies           String?
  antecedentsMed      String?                 @map("antecedents_med")
  antecedentsChir     String?                 @map("antecedents_chir")
  antecedentsFam      String?                 @map("antecedents_fam")
  photoUrl            String?                 @map("photo_url")
  assurance           String?
  numAssurance        String?                 @map("num_assurance")
  isActive            Boolean                 @default(true) @map("is_active")
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  source              String?
  prisEnChargePar     String?                 @map("pris_en_charge_par")
  personneResponsable String?                 @map("personne_responsable")
  age                 Int?
  appointments        KlinikAppointment[]
  consultations       KlinikConsultation[]
  hospitalizations    KlinikHospitalization[]
  labOrders           KlinikLabOrder[]
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prescriptions       KlinikPrescription[]
  klinik_services     klinik_services[]

  @@index([tenantId])
  @@map("klinik_patients")
}

model KlinikAppointment {
  id           String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId     String              @map("tenant_id")
  patientId    String              @map("patient_id")
  doctorName   String              @map("doctor_name")
  dateHeure    DateTime            @map("date_heure") @db.Timestamptz(6)
  dureeMin     Int                 @default(30) @map("duree_min")
  motif        String
  statut       AppointmentStatut   @default(en_attente)
  notes        String?
  createdBy    String?             @map("created_by")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  prix         Float?
  recurrence   String?             @default("none")
  recurEnd     DateTime?           @map("recur_end") @db.Timestamp(6)
  patient      KlinikPatient       @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  consultation KlinikConsultation?

  @@index([tenantId])
  @@index([patientId])
  @@index([dateHeure])
  @@map("klinik_appointments")
}

model KlinikConsultation {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId           String               @map("tenant_id")
  patientId          String               @map("patient_id")
  appointmentId      String?              @unique @map("appointment_id")
  doctorName         String               @map("doctor_name")
  date               DateTime             @default(now()) @db.Timestamptz(6)
  statut             ConsultationStatut   @default(brouillon)
  poidsKg            Float?               @map("poids_kg")
  tailleCm           Float?               @map("taille_cm")
  tensionSys         Int?                 @map("tension_sys")
  tensionDia         Int?                 @map("tension_dia")
  temperature        Float?
  pouls              Int?
  spo2               Int?
  glycemie           Float?
  motif              String?
  anamnese           String?
  examenClinique     String?              @map("examen_clinique")
  diagnostic         String?
  traitement         String?
  notesInternes      String?              @map("notes_internes")
  createdBy          String?              @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fc                 Int?
  fr                 Int?
  saO2               Int?                 @map("sa_o2")
  antecedents        String?
  rfa                String?
  impressionClinique String?              @map("impression_clinique")
  paraclinique       String?
  appointment        KlinikAppointment?   @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient            KlinikPatient        @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  labOrders          KlinikLabOrder[]
  prescriptions      KlinikPrescription[]

  @@index([tenantId])
  @@index([patientId])
  @@map("klinik_consultations")
}

model KlinikPrescription {
  id             String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId       String                   @map("tenant_id")
  consultationId String?                  @map("consultation_id")
  patientId      String                   @map("patient_id")
  doctorName     String                   @map("doctor_name")
  date           DateTime                 @default(now()) @db.Timestamptz(6)
  statut         PrescriptionStatut       @default(active)
  notes          String?
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          KlinikPrescriptionItem[]
  consultation   KlinikConsultation?      @relation(fields: [consultationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient        KlinikPatient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([patientId])
  @@map("klinik_prescriptions")
}

model KlinikPrescriptionItem {
  id             String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  prescriptionId String             @map("prescription_id")
  medicamentNom  String             @map("medicament_nom")
  dosage         String
  frequence      String
  duree          String
  instructions   String?
  quantite       Int                @default(1)
  prescription   KlinikPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("klinik_prescription_items")
}

model KlinikLabOrder {
  id             String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId       String              @map("tenant_id")
  consultationId String?             @map("consultation_id")
  patientId      String              @map("patient_id")
  doctorName     String              @map("doctor_name")
  dateCommande   DateTime            @default(now()) @map("date_commande") @db.Timestamptz(6)
  statut         LabOrderStatut      @default(en_attente)
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          KlinikLabItem[]
  consultation   KlinikConsultation? @relation(fields: [consultationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient        KlinikPatient       @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([patientId])
  @@map("klinik_lab_orders")
}

model KlinikLabItem {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  labOrderId    String         @map("lab_order_id")
  testNom       String         @map("test_nom")
  testCode      String?        @map("test_code")
  valeurNormale String?        @map("valeur_normale")
  valeur        String?
  unite         String?
  estAnormal    Boolean        @default(false) @map("est_anormal")
  notesResultat String?        @map("notes_resultat")
  dateResultat  DateTime?      @map("date_resultat") @db.Timestamptz(6)
  labOrder      KlinikLabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("klinik_lab_items")
}

model KlinikHospitalization {
  id              String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId        String                @map("tenant_id")
  patientId       String                @map("patient_id")
  doctorName      String                @map("doctor_name")
  dateAdmission   DateTime              @default(now()) @map("date_admission") @db.Timestamptz(6)
  dateDecharge    DateTime?             @map("date_decharge") @db.Timestamptz(6)
  chambre         String?
  lit             String?
  motifAdmission  String                @map("motif_admission")
  diagnosticFinal String?               @map("diagnostic_final")
  statut          HospitalizationStatut @default(admis)
  notes           String?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  signeVitaux     Json?                 @default("[]") @map("signe_vitaux")
  numeroChambre   String?               @map("numero_chambre")
  diagnostic      String?
  traitement      String?
  protokol        Json?                 @default("{}")
  patient         KlinikPatient         @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([patientId])
  @@map("klinik_hospitalizations")
}
