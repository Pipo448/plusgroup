// prisma/schema/internet.prisma

model internet_tenants {
  id               Int      @id @default(autoincrement())
  name             String
  owner_name       String?
  phone            String?
  email            String?
  slug             String   @unique
  active           Boolean  @default(true)
  created_at       DateTime @default(now())
  manager_name     String?
  manager_email    String?  @unique
  manager_password String?
  hotspot_message String?

  clients  internet_clients[]
  configs  mikrotik_config[]
  payments internet_payments[]
  plans    internet_plans[]
}

model internet_plans {
  id                 Int      @id @default(autoincrement())
  internet_tenant_id Int?
  name               String
  mikrotik_profile   String
  speed_mbps         Int
  duration_days      Int
  price_htg          Decimal? @db.Decimal(10, 2)
  data_limit_gb      Int?
  max_devices        Int      @default(1)
  active             Boolean  @default(true)
  created_at         DateTime @default(now())

  tenant  internet_tenants? @relation(fields: [internet_tenant_id], references: [id], onDelete: Cascade)
  clients internet_clients[]
}

model internet_clients {
  id                 Int       @id @default(autoincrement())
  internet_tenant_id Int?
  plan_id            Int?
  full_name          String
  phone              String?
  email              String?
  mikrotik_username  String    @unique
  mikrotik_password  String
  plan_name          String?
  expires_at         DateTime?
  activated_at       DateTime? @default(now())
  created_at         DateTime  @default(now())

  tenant   internet_tenants? @relation(fields: [internet_tenant_id], references: [id], onDelete: Cascade)
  plan     internet_plans?   @relation(fields: [plan_id], references: [id])
  payments internet_payments[]
}

model mikrotik_config {
  id                 Int      @id @default(autoincrement())
  internet_tenant_id Int?
  host               String
  port               Int      @default(8728)
  username           String
  password           String
  use_ssl            Boolean  @default(false)
  created_at         DateTime @default(now())

  tenant internet_tenants? @relation(fields: [internet_tenant_id], references: [id], onDelete: Cascade)
}

model internet_payments {
  id                 Int      @id @default(autoincrement())
  internet_tenant_id Int?
  client_id          Int
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("HTG")
  plan_name          String?
  duration_days      Int?
  paid_at            DateTime @default(now())
  renewed_by         String?

  tenant internet_tenants? @relation(fields: [internet_tenant_id], references: [id])
  client internet_clients  @relation(fields: [client_id], references: [id])
}
