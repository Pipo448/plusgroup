model DryOrder {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId      String         @map("tenant_id")
  branchId      String?        @map("branch_id")
  orderNumber   String         @map("order_number") @db.VarChar(50)
  clientName    String         @map("client_name") @db.VarChar(200)
  clientPhone   String?        @map("client_phone") @db.VarChar(50)
  depositDate   DateTime       @default(now()) @map("deposit_date") @db.Timestamptz(6)
  pickupDate    DateTime       @map("pickup_date") @db.Timestamptz(6)
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(6)
  status        DryOrderStatus @default(received)
  totalHtg      Decimal        @default(0) @map("total_htg") @db.Decimal(14, 2)
  amountPaidHtg Decimal        @default(0) @map("amount_paid_htg") @db.Decimal(14, 2)
  balanceDueHtg Decimal        @default(0) @map("balance_due_htg") @db.Decimal(14, 2)
  notes         String?
  cancelReason  String?        @map("cancel_reason")
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items         DryOrderItem[]
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator       User?          @relation("DryOrderCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments      DryPayment[]

  @@unique([tenantId, orderNumber])
  @@index([branchId], map: "dry_orders_branch_idx")
  @@index([tenantId, status], map: "dry_orders_status_idx")
  @@index([tenantId], map: "dry_orders_tenant_idx")
  @@map("dry_orders")
}

model DryOrderItem {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId     String   @map("tenant_id")
  orderId      String   @map("order_id")
  service      String   @db.VarChar(50)
  description  String   @db.VarChar(200)
  color        String?  @db.VarChar(50)
  quantity     Int      @default(1)
  unitPriceHtg Decimal  @default(0) @map("unit_price_htg") @db.Decimal(12, 2)
  totalHtg     Decimal  @default(0) @map("total_htg") @db.Decimal(14, 2)
  notes        String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order        DryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "dry_items_order_idx")
  @@map("dry_order_items")
}

model DryPayment {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId    String        @map("tenant_id")
  orderId     String        @map("order_id")
  amountHtg   Decimal       @default(0) @map("amount_htg") @db.Decimal(14, 2)
  method      PaymentMethod @default(cash)
  reference   String?       @db.VarChar(200)
  amountGiven Decimal?      @default(0) @map("amount_given") @db.Decimal(14, 2)
  change      Decimal?      @default(0) @db.Decimal(14, 2)
  paymentDate DateTime      @default(now()) @map("payment_date") @db.Timestamptz(6)
  notes       String?
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  creator     User?         @relation("DryPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       DryOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "dry_payments_order_idx")
  @@map("dry_payments")
}
