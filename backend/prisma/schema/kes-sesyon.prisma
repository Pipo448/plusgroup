// backend/prisma/schema/kes-sesyon.prisma

// ✅ NOUVO — Sesyon Kès: chak kesye louvri yon sesyon lè l kòmanse travay
// (ak fon kès inisyal la), epi fèmen l lè l fini (kantite kòb li konte nan
// tiwa a). Sistèm nan kalkile sa ki te "dwe la" (fon inisyal + tout vant
// kach pandan sesyon an) epi montre ekà a — san l pa bloke anyen, se yon
// rapò enfòmatif pou responsab la.
model pg_kes_sesyon {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenant_id      String
  user_id        String
  fon_kes_ouveti Decimal   @db.Decimal(12, 2)
  fon_kes_femen  Decimal?  @db.Decimal(12, 2)
  vant_kach      Decimal?  @db.Decimal(14, 2)
  atann          Decimal?  @db.Decimal(14, 2)
  eka            Decimal?  @db.Decimal(14, 2)
  status         String    @default("louvri") @db.VarChar(10) // 'louvri' | 'femen'
  opened_at      DateTime  @default(now()) @db.Timestamptz(6)
  closed_at      DateTime? @db.Timestamptz(6)
  notes          String?
  tenants        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pg_kes_sesyon_tenant_fk")
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pg_kes_sesyon_user_fk")

  @@index([tenant_id, status], map: "idx_kes_sesyon_tenant_status")
  @@index([user_id], map: "idx_kes_sesyon_user")
}

// ✅ NOUVO — Kontwòl Estòk: yon "foto" kantite yon pwodwi genyen nan
// sistèm nan (kantite_sistem) konpare ak sa yo konte fizikman
// (kantite_konte). Se yon RAPÒ sèlman — li PA touche Product.quantity,
// responsab la deside apre si l bezwen ajiste estòk la alamen.
model pg_estok_kontwol {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenant_id       String
  product_id      String
  kantite_sistem  Decimal  @db.Decimal(12, 3)
  kantite_konte   Decimal  @db.Decimal(12, 3)
  eka             Decimal  @db.Decimal(12, 3)
  notes           String?
  created_by      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  tenants         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pg_estok_kontwol_tenant_fk")
  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pg_estok_kontwol_product_fk")
  creator         User?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pg_estok_kontwol_creator_fk")

  @@index([tenant_id, product_id], map: "idx_estok_kontwol_tenant_product")
  @@index([created_at], map: "idx_estok_kontwol_date")
}
