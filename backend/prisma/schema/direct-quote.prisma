// prisma/schema/direct-quote.prisma
// ─── Devi Dirèk: pwodui/sèvis ki PA nan katalòg estòk la ─────
// Modil KONPLÈTMAN separe de Quote/QuoteItem — kòb sa yo pa
// dwe janm melanje ak rapò lavant/estòk sistèm nan.

enum DirectQuoteStatus {
  draft
  sent
  accepted
  converted
  cancelled
}

model DirectQuote {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  quoteNumber           String            @map("quote_number") @db.VarChar(50)
  clientId              String?           @map("client_id")
  clientSnapshot        Json              @map("client_snapshot")
  currency              DefaultCurrency   @default(HTG)
  exchangeRate          Decimal           @map("exchange_rate") @db.Decimal(10, 4)
  subtotalHtg           Decimal           @default(0) @map("subtotal_htg") @db.Decimal(14, 2)
  subtotalUsd           Decimal           @default(0) @map("subtotal_usd") @db.Decimal(14, 2)
  discountType          String            @default("amount") @map("discount_type") @db.VarChar(10)
  discountValue         Decimal           @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountHtg           Decimal           @default(0) @map("discount_htg") @db.Decimal(14, 2)
  discountUsd           Decimal           @default(0) @map("discount_usd") @db.Decimal(14, 2)
  totalHtg              Decimal           @default(0) @map("total_htg") @db.Decimal(14, 2)
  totalUsd              Decimal           @default(0) @map("total_usd") @db.Decimal(14, 2)
  status                DirectQuoteStatus @default(draft)
  issueDate             DateTime          @default(now()) @map("issue_date") @db.Timestamptz(6)
  expiryDate            DateTime?         @map("expiry_date") @db.Timestamptz(6)
  notes                 String?
  terms                 String?
  createdBy             String?           @map("created_by")
  // ✅ Si moun ki kreye a se yon kesye (pa admin), sa a rekòd KI ADMIN
  // ki otorize l ak PIN pa li. Rete NULL si se admin ki kreye l dirèkteman.
  authorizedBy           String?          @map("authorized_by")
  authorizedAt           DateTime?        @map("authorized_at") @db.Timestamptz(6)
  convertedToInvoiceId   String?          @map("converted_to_invoice_id")
  convertedAt            DateTime?        @map("converted_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  branchId               String?          @map("branch_id")
  // ✅ Pataje piblik — menm mekanis ak Quote (san kòd PIN, dirèk)
  publicToken            String?          @unique @map("public_token") @db.VarChar(64)
  publicViewedAt         DateTime?        @map("public_viewed_at") @db.Timestamptz(6)
  publicViewCount        Int              @default(0) @map("public_view_count")

  items                  DirectQuoteItem[]
  branch                 Branch?          @relation(fields: [branchId], references: [id], onUpdate: NoAction)
  client                 Client?          @relation(fields: [clientId], references: [id])
  creator                User?            @relation("DirectQuoteCreatedBy", fields: [createdBy], references: [id])
  authorizer             User?            @relation("DirectQuoteAuthorizedBy", fields: [authorizedBy], references: [id])
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, quoteNumber])
  @@index([branchId])
  @@index([publicToken])
  @@map("direct_quotes")
}

model DirectQuoteItem {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  directQuoteId String      @map("direct_quote_id")
  // ✅ Non pwodui/sèvis TAPE ALAMEN — pa gen lyen ak katalòg Product la
  description   String      @db.VarChar(300)
  // ✅ NOUVO — Foto pwodui a (opsyonèl), ak Gwosè si atik la mande sa
  // (rad, soulye, elatriye)
  imageUrl      String?     @map("image_url")
  size          String?     @db.VarChar(30)
  quantity      Decimal     @db.Decimal(12, 3)
  unitPriceHtg  Decimal     @map("unit_price_htg") @db.Decimal(12, 2)
  unitPriceUsd  Decimal     @default(0) @map("unit_price_usd") @db.Decimal(12, 2)
  discountAmt   Decimal     @default(0) @map("discount_amt") @db.Decimal(12, 2)
  totalHtg      Decimal     @map("total_htg") @db.Decimal(14, 2)
  totalUsd      Decimal     @default(0) @map("total_usd") @db.Decimal(14, 2)
  sortOrder     Int         @default(0) @map("sort_order")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  directQuote   DirectQuote @relation(fields: [directQuoteId], references: [id], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("direct_quote_items")
}
